# development or production. In development OTP codes are written to the log.
APP_ENV=development
HTTP_ADDR=:8080
# debug, info, warn or error
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/tidy?sslmode=disable
# Apply migrations on start-up. Handy for docker compose; use `make migrate` otherwise.
AUTO_MIGRATE=false

# At least 32 characters. Signs access tokens and hashes OTP codes.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Working hours and daily reports use this time zone.
TIMEZONE=Europe/London
# Cleaners further than this from the address don't get the job.
DISPATCH_RADIUS_KM=15

# mock authorises every payment instantly (development only), stripe uses Stripe.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# log writes push notifications to the log, fcm sends them with Firebase.
PUSH_PROVIDER=log
# The whole service account JSON file, on one line.
FCM_SERVICE_ACCOUNT_JSON=

# Comma separated. The admin web app runs on one of these.
CORS_ALLOWED_ORIGINS=http://localhost:*
# Host patterns allowed to open a WebSocket from a browser. Mobile apps send no Origin.
WS_ORIGIN_PATTERNS=localhost:*
